---
export const prerender = true;
import Layout from "@/layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { DATA } from "@/data/resume";
import { formatDate } from "@/lib/utils";
import { mdxComponents } from "@/mdx-components";

const WORDS_PER_MINUTE = 220;

function getReadingTime(body?: string) {
  const words = (body ?? "")
    .replace(/```[\s\S]*?```/g, " ")
    .replace(/<[^>]+>/g, " ")
    .split(/\s+/)
    .filter(Boolean).length;

  return Math.max(1, Math.ceil(words / WORDS_PER_MINUTE));
}

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const sortedPosts = [...posts].sort((a, b) => {
    if (new Date(a.data.publishedAt) > new Date(b.data.publishedAt)) return -1;
    return 1;
  });
  return sortedPosts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      previousPost: index > 0 ? sortedPosts[index - 1] : null,
      nextPost: index < sortedPosts.length - 1 ? sortedPosts[index + 1] : null,
      relatedPosts: sortedPosts
        .filter((candidate) => candidate.id !== post.id)
        .map((candidate) => {
          const postTags = new Set(post.data.tags);
          const sharedTags = candidate.data.tags.filter((tag) =>
            postTags.has(tag)
          ).length;
          const categoryScore =
            candidate.data.category === post.data.category ? 2 : 0;

          return {
            post: candidate,
            score: sharedTags + categoryScore,
          };
        })
        .sort((a, b) => {
          if (b.score !== a.score) return b.score - a.score;
          return (
            new Date(b.post.data.publishedAt).getTime() -
            new Date(a.post.data.publishedAt).getTime()
          );
        })
        .slice(0, 3)
        .map(({ post }) => post),
    },
  }));
}

const { post, previousPost, nextPost, relatedPosts } = Astro.props;
const { title, publishedAt, summary, image, category, tags, author } = post.data;
const slug = post.id;

const { Content, headings } = await render(post);
const readingTime = getReadingTime(post.body);
const tableOfContents = headings.filter(
  (heading) => heading.depth >= 2 && heading.depth <= 3
);
const authorName = author ?? DATA.name;
const navGridClass =
  previousPost && nextPost ? "grid gap-3 sm:grid-cols-2" : "grid gap-3";
const blogGridClass =
  "grid gap-10 lg:grid-cols-[minmax(0,680px)_260px] lg:items-start lg:justify-center";

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  datePublished: publishedAt,
  dateModified: publishedAt,
  description: summary,
  articleSection: category,
  keywords: tags,
  image: image
    ? image.startsWith("http")
      ? image
      : `${DATA.url}${image}`
    : `${DATA.url}/og_image.png`,
  url: `${DATA.url}/blog/${slug}`,
  author: {
    "@type": "Person",
    name: authorName,
  },
}).replace(/</g, "\\u003c");
---

<Layout
  title={title}
  description={summary}
  image={image}
  canonicalURL={`${DATA.url}/blog/${slug}`}
  ogType="article"
  containerClass="max-w-5xl"
>
  <section id="blog">
    <script is:inline type="application/ld+json" set:html={jsonLd} />
    <div
      id="reading-progress"
      class="pointer-events-none fixed left-0 top-0 z-50 h-1 w-full bg-transparent"
      aria-hidden="true"
    >
      <div
        data-reading-progress
        class="h-full w-full origin-left scale-x-0 bg-foreground transition-transform duration-150 ease-out"
      >
      </div>
    </div>

    <div class={blogGridClass}>
      <div class="min-w-0">
        <div class="flex justify-start gap-4 items-center">
          <a
            href="/blog"
            class="mb-8 inline-flex items-center gap-1 rounded-lg border border-border px-2 py-1 text-sm text-muted-foreground transition-colors hover:text-foreground group"
            aria-label="Back to Blog"
          >
            <span class="transition-transform group-hover:-translate-x-px" aria-hidden>
              &lt;-
            </span>
            Back to Blog
          </a>
        </div>

        <header class="space-y-6">
          {
            image && (
              <div class="relative overflow-hidden rounded-2xl border border-border bg-muted aspect-[16/9] sm:aspect-[16/7]">
                <img
                  src={image}
                  alt={title}
                  class="size-full object-cover"
                  loading="eager"
                  decoding="async"
                />
                <div class="absolute left-4 top-4 rounded-full border border-white/20 bg-black/70 px-3 py-1 text-xs font-medium text-white shadow-sm">
                  {category}
                </div>
              </div>
            )
          }

          <div class="space-y-5">
            <div class="flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
              <span class="inline-flex items-center gap-1 rounded-full border border-border bg-card px-2.5 py-1">
                <span class="font-medium text-foreground">Date</span>
                {formatDate(publishedAt)}
              </span>
              <span class="inline-flex items-center gap-1 rounded-full border border-border bg-card px-2.5 py-1">
                <span class="font-medium text-foreground">Read</span>
                {readingTime} min read
              </span>
              <span class="inline-flex items-center gap-1 rounded-full border border-border bg-card px-2.5 py-1">
                <span class="font-medium text-foreground">Topic</span>
                {category}
              </span>
            </div>

            <div class="space-y-3">
              <h1 class="title text-balance font-semibold text-3xl leading-tight tracking-tighter md:text-5xl">
                {title}
              </h1>
              <p class="max-w-2xl text-pretty text-base leading-7 text-muted-foreground md:text-lg">
                {summary}
              </p>
            </div>

            <div class="flex flex-wrap gap-2">
              {
                tags.map((tag) => (
                  <span class="inline-flex items-center gap-1 rounded-full border border-border bg-background px-2.5 py-1 text-xs text-muted-foreground">
                    <span aria-hidden>#</span>
                    {tag}
                  </span>
                ))
              }
            </div>
          </div>
        </header>
      </div>

      <div class="hidden lg:block" aria-hidden="true"></div>

      <div class="min-w-0">
        <div class="my-8 flex w-full items-center">
          <div
            class="flex-1 h-px bg-border"
            style="mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent); -webkit-mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);"
          >
          </div>
        </div>
      </div>

      <div class="hidden lg:block" aria-hidden="true"></div>
    </div>

    <div class={blogGridClass}>
      <div class="min-w-0">
        {
          tableOfContents.length > 0 && (
            <details class="mb-8 rounded-xl border border-border bg-card p-4 lg:hidden">
              <summary class="cursor-pointer text-sm font-semibold">
                Table of contents
              </summary>
              <ol class="mt-4 space-y-2 text-sm text-muted-foreground">
                {tableOfContents.map((heading) => (
                  <li class={heading.depth === 3 ? "pl-4" : ""}>
                    <a
                      href={`#${heading.slug}`}
                      class="hover:text-foreground transition-colors"
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ol>
            </details>
          )
        }

        <article
          data-reading-article
          class="prose max-w-full text-pretty font-sans leading-relaxed text-muted-foreground dark:prose-invert prose-headings:scroll-mt-24 prose-headings:text-foreground prose-a:text-foreground prose-a:underline-offset-4 prose-img:rounded-xl"
        >
          <Content components={mdxComponents} />
        </article>

        <section class="article-footer mt-12 rounded-2xl border border-border bg-card p-5">
          <div class="grid gap-4 sm:grid-cols-[72px_minmax(0,1fr)_auto] sm:items-center">
            <img
              src={DATA.avatarUrl}
              alt={authorName}
              class="size-16 rounded-2xl border border-border object-cover"
              loading="lazy"
              decoding="async"
            />
            <div class="min-w-0 flex-1">
              <p class="text-xs font-medium uppercase tracking-[0.18em] text-muted-foreground">
                About the author
              </p>
              <h2 class="mt-1 text-lg font-semibold tracking-tight">
                {authorName}
              </h2>
              <p class="mt-1 text-sm leading-6 text-muted-foreground">
                {DATA.description}
              </p>
            </div>
            <a
              href="/#contact"
              class="inline-flex h-9 w-fit items-center justify-center gap-2 rounded-lg border border-border px-3 text-sm font-medium transition-colors hover:bg-accent/50"
            >
              Contact
              <span aria-hidden>-&gt;</span>
            </a>
          </div>
        </section>

        {
          relatedPosts.length > 0 && (
            <section class="mt-10">
              <div class="mb-4 flex items-center justify-between gap-3">
                <h2 class="text-lg font-semibold tracking-tight">
                  Related posts
                </h2>
                <a
                  href="/blog"
                  class="text-sm text-muted-foreground transition-colors hover:text-foreground"
                >
                  View all
                </a>
              </div>
              <div class="grid gap-3 md:grid-cols-2">
                {relatedPosts.map((relatedPost) => (
                  <a
                    href={`/blog/${relatedPost.id}`}
                    class="group flex min-h-44 flex-col rounded-xl border border-border bg-card p-4 transition-colors hover:bg-accent/40"
                  >
                    <div class="mb-3 flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
                      <span>{relatedPost.data.category}</span>
                      <span aria-hidden="true">/</span>
                      <span>{formatDate(relatedPost.data.publishedAt)}</span>
                    </div>
                    <h3 class="text-sm font-semibold leading-6 tracking-tight group-hover:text-foreground">
                      {relatedPost.data.title}
                    </h3>
                    <p class="mt-2 line-clamp-2 text-sm leading-6 text-muted-foreground">
                      {relatedPost.data.summary}
                    </p>
                  </a>
                ))}
              </div>
            </section>
          )
        }

        <nav class="mt-10 border-t border-border pt-6">
          <div class={navGridClass}>
            {
              previousPost && (
                <a
                  href={`/blog/${previousPost.id}`}
                  class="group flex min-h-24 flex-col justify-between gap-2 rounded-xl border border-border bg-card p-4 transition-colors hover:bg-accent/50"
                >
                  <span class="flex items-center gap-1 text-xs text-muted-foreground">
                    <span aria-hidden>&lt;-</span>
                    Previous
                  </span>
                  <span class="text-sm font-medium leading-6 transition-colors group-hover:text-foreground whitespace-normal wrap-break-word">
                    {previousPost.data.title}
                  </span>
                </a>
              )
            }

            {
              nextPost && (
                <a
                  href={`/blog/${nextPost.id}`}
                  class="group flex min-h-24 flex-col justify-between gap-2 rounded-xl border border-border bg-card p-4 text-right transition-colors hover:bg-accent/50"
                >
                  <span class="flex items-center justify-end gap-1 text-xs text-muted-foreground">
                    Next
                    <span aria-hidden>-&gt;</span>
                  </span>
                  <span class="text-sm font-medium leading-6 transition-colors group-hover:text-foreground whitespace-normal wrap-break-word">
                    {nextPost.data.title}
                  </span>
                </a>
              )
            }
          </div>
        </nav>
      </div>

      {
        tableOfContents.length > 0 && (
          <aside class="hidden lg:block">
            <div class="sticky top-24 rounded-xl border border-border bg-card p-4">
              <p class="mb-3 text-sm font-semibold tracking-tight">
                Table of contents
              </p>
              <ol class="space-y-2 text-sm text-muted-foreground">
                {tableOfContents.map((heading) => (
                  <li class={heading.depth === 3 ? "pl-4" : ""}>
                    <a
                      href={`#${heading.slug}`}
                      class="block transition-colors hover:text-foreground"
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ol>
            </div>
          </aside>
        )
      }
    </div>

    <script is:inline>
      const progressBar = document.querySelector("[data-reading-progress]");
      const article = document.querySelector("[data-reading-article]");

      function updateReadingProgress() {
        if (!progressBar || !article) return;

        const rect = article.getBoundingClientRect();
        const articleTop = window.scrollY + rect.top;
        const scrollableDistance = article.scrollHeight - window.innerHeight;
        const currentPosition = window.scrollY - articleTop;
        const progress =
          scrollableDistance <= 0
            ? 1
            : Math.min(Math.max(currentPosition / scrollableDistance, 0), 1);

        progressBar.style.transform = `scaleX(${progress})`;
      }

      updateReadingProgress();
      window.addEventListener("scroll", updateReadingProgress, {
        passive: true,
      });
      window.addEventListener("resize", updateReadingProgress);

      document.addEventListener("click", async function (event) {
        var button = event.target && event.target.closest("[data-copy-code]");
        if (!button) return;

        var container = button.closest(".group");
        var code = container && container.querySelector("code");
        var text = code && code.textContent;
        if (!text || !navigator.clipboard) return;

        try {
          await navigator.clipboard.writeText(text);
          button.textContent = "Copied";
          window.setTimeout(function () {
            button.textContent = "Copy";
          }, 1600);
        } catch (_) {}
      });
    </script>
  </section>
</Layout>
